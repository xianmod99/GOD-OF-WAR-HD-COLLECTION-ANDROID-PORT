<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- a pasta do jogo fica no armazenamento comum (a mesma pasta do PC, copiada) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- lista e download dos drivers Vulkan (GitHub), como no DroidDeck -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- atualização automática pelas releases do GitHub (Atualizador.java) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:label="God of War Collection"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Tema"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:isGame="true"
        android:appCategory="game">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- processo próprio: o LoadExec do Vita (menu -> jogo) troca o processo inteiro -->
        <activity
            android:name=".GameActivity"
            android:process=":jogo"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:resizeableActivity="false" />

        <!-- tela "Mapear botões do controle" (grava padmap.txt na pasta do jogo) -->
        <activity
            android:name=".MapearControleActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density" />

        <activity
            android:name=".RelaunchActivity"
            android:process=":relanca"
            android:exported="false"
            android:theme="@style/Tema.Invisivel"
            android:excludeFromRecents="true" />
    </application>
</manifest>
